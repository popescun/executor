# Google C++ style, with the line limit widened to 100.
#
# The same configuration as the async repo, so a source moving between the two
# is not reformatted by the move.
Language: Cpp
BasedOnStyle: Google
Standard: c++20

ColumnLimit: 100
LineEnding: DeriveLF

# Google derives pointer alignment per file; pin it so it is consistent.
DerivePointerAlignment: false
PointerAlignment: Left
